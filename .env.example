# ============================================================
# EventoAI — Example environment configuration
# This file must contain placeholders only, never real secrets.
# ============================================================

# Google Gemini API — server-side secret
GEMINI_API_KEY=

# Primary free-tier model and approved free-tier fallback
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_ENABLE_FREE_FALLBACK=true

# Reasoning configuration
GEMINI_PRIMARY_THINKING_LEVEL=medium
GEMINI_FALLBACK_THINKING_LEVEL=low

# Maximum generated tokens, including the model's thinking budget
GEMINI_MAX_OUTPUT_TOKENS=8192

# Supabase — configured in a later phase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production API rate limiting (obtain credentials from Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
